{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.appstoretracker/mcp",
  "title": "App Store Tracker",
  "description": "iOS App Store chart rankings, app details, reviews, keywords and revenue estimates.",
  "version": "1.0.1",
  "websiteUrl": "https://www.appstoretracker.com/mcp",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://www.appstoretracker.com/api/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer <API key>; create one at https://www.appstoretracker.com/account/api",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/top-init/appstoretracker-mcp-registry-listing",
    "source": "github"
  }
}
